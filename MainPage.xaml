<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             Shell.NavBarIsVisible="False">
    
    <Grid>
        <Image Source="background1.png"
           Aspect="AspectFill"
           InputTransparent="True" />

        <Grid Padding="16"
          RowSpacing="12"
          RowDefinitions="Auto,*,Auto">

        <Label x:Name="GreetingLabel"
               FontSize="24"
               HorizontalTextAlignment="Center" />

        <ImageButton Grid.Row="1"
             Source="fridge_closed.png"
             Aspect="AspectFit"
             BackgroundColor="Transparent"
             Padding="0"
             SemanticProperties.Description="Открыть холодильник"
             Clicked="OnHelloClicked" />

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">

            <Button Text="Холодильник" Padding="4,12" />
                <Button Grid.Column="1"
                    Text="Рецепты"
                    Padding="4,12"
                    Clicked="OnRecipesClicked" />   
            
            <Button Grid.Column="2" Text="Главная" Padding="4,12" />
                <Button Grid.Column="2"
                    Text="Главная"
                    Padding="4,12"
                    Clicked="OnProfileClicked" />   

            </Grid>
    </Grid>
    </Grid>
</ContentPage>